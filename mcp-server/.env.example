# fo4-mcp config — kullanıcı .env olarak kopyala ve düzenle.
# Tüm path'ler opsiyonel — fo4-mcp auto-detect dener, .env override eder.

# FO4 Steam install (READ-ONLY için kullanılır — asla yazma)
FO4_INSTALL_DIR=C:/Program Files (x86)/Steam/steamapps/common/Fallout 4

# Kullanıcı save / INI / profile (READ-ONLY)
FO4_USER_DOCS=%USERPROFILE%/Documents/My Games/Fallout4
FO4_LOCALAPPDATA=%LOCALAPPDATA%/Fallout4

# MO2 instance dir (kuruluysa). Portable mode: instance kendisi MO2 dir.
# Boş bırakılırsa fo4-mcp default %LOCALAPPDATA%/ModOrganizer/Fallout4 dener.
MO2_INSTANCE_DIR=

# tools/ override — repo dışında bir konumda binary'leri tutuyorsan.
FO4_TOOLS_DIR=

# Repo root (auto-detect: pyproject.toml'in parent'i). Override için gerekirse.
FO4_REPO_ROOT=

# Logging level: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Subprocess default timeout (saniye)
SUBPROCESS_TIMEOUT=120
